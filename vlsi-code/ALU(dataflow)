        SEL <= "001"; wait for 10 ns;
        SEL <= "010"; wait for 10 ns;
        SEL <= "011"; wait for 10 ns;
        SEL <= "100"; wait for 10 ns;
        SEL <= "101"; wait for 10 ns;
        SEL <= "110"; wait for 10 ns;
        SEL <= "111"; wait for 10 ns;

