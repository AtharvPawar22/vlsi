
library IEEE;
use IEEE.STD_LOGIC_1164.ALL;

entity Halfadder is
    Port ( A : in  STD_LOGIC;
           B : in  STD_LOGIC;
           SUM : out  STD_LOGIC;
           CARRY : out  STD_LOGIC);
end Halfadder;

architecture Behavioral of Halfadder is

begin
		process(A,B)
		begin
			SUM <= A XOR B;
			CARRY <= A AND B;
		end process;

end Behavioral;























