
library IEEE;
use IEEE.STD_LOGIC_1164.ALL;

entity Universal_Shift_Register is
    Port ( CLK : in  STD_LOGIC;
           RST : in  STD_LOGIC;
           S : in  STD_LOGIC_VECTOR (1 downto 0);
           SL : in  STD_LOGIC;
           SR : in  STD_LOGIC;
           P : in  STD_LOGIC_VECTOR (3 downto 0);
           Q : out  STD_LOGIC_VECTOR (3 downto 0));
end Universal_Shift_Register;

architecture Behavioral of Universal_Shift_Register is

	signal Q_reg : STD_LOGIC_VECTOR(3 downto 0);

begin
process(CLK,RST)
begin
		
	if RST = '1' then 
		Q_reg <="0000";
	elsif rising_edge(CLK) then 
		
		case S is 
		
				when "00" => Q_reg <= Q_reg;
				when "01" => Q_reg <= SR & Q_reg(3 downto 1);
				when "10" => Q_reg <= Q_reg(2 downto 0) & SL;
				when "11" => Q_reg <= P;
				when others => Q_reg <= Q_reg;
			
		end case;
		end if;
		end process;
		Q <= Q_reg;
end Behavioral;




