

library IEEE;
use IEEE.STD_LOGIC_1164.ALL;


entity mux8to1 is
    Port (
        I : in  STD_LOGIC_VECTOR(7 downto 0);
        S : in  STD_LOGIC_VECTOR(2 downto 0);
        Y : out STD_LOGIC
    );
end mux8to1;

architecture Dataflow of mux8to1 is
begin


    Y <= I(0) when S = "000" else
         I(1) when S = "001" else
         I(2) when S = "010" else
         I(3) when S = "011" else
         I(4) when S = "100" else
         I(5) when S = "101" else
         I(6) when S = "110" else
         I(7) when S = "111" else
         '0';			

end Dataflow;



