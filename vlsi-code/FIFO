
library IEEE;
use IEEE.STD_LOGIC_1164.ALL;

entity STD_FIFO is
    Generic (
        DATA_WIDTH : positive := 8;
        FIFO_DEPTH : positive := 8
    );

    Port (
        CLK     : in  STD_LOGIC;
        RST     : in  STD_LOGIC;
        WriteEn : in  STD_LOGIC;
        DataIn  : in  STD_LOGIC_VECTOR(DATA_WIDTH-1 downto 0);
        ReadEn  : in  STD_LOGIC;
        DataOut : out STD_LOGIC_VECTOR(DATA_WIDTH-1 downto 0);
        Empty   : out STD_LOGIC;
        Full    : out STD_LOGIC
    );
end STD_FIFO;

architecture Behavioral of STD_FIFO is

    type FIFO_Memory is array (0 to FIFO_DEPTH-1)
        of STD_LOGIC_VECTOR(DATA_WIDTH-1 downto 0);

begin

    fifo_proc: process(CLK)

        variable Memory : FIFO_Memory;
        variable Head : integer range 0 to FIFO_DEPTH-1 := 0;
        variable Tail : integer range 0 to FIFO_DEPTH-1 := 0;
        variable Count : integer range 0 to FIFO_DEPTH := 0;


    begin

        if rising_edge(CLK) then

            if RST = '1' then

                Head := 0;
                Tail := 0;
                Count := 0;

                DataOut <= (others => '0');
                Empty <= '1';
                Full <= '0';

            else

                -- READ OPERATION
                if ReadEn = '1' and Count > 0 then

                    DataOut <= Memory(Head);

                    Head := (Head + 1) mod FIFO_DEPTH;
                    Count := Count - 1;

                end if;

                -- WRITE OPERATION
                if WriteEn = '1' and Count < FIFO_DEPTH then

                    Memory(Tail) := DataIn;

                    Tail := (Tail + 1) mod FIFO_DEPTH;
                    Count := Count + 1;

                end if;


                -- FIFO STATUS
                if Count = 0 then
                    Empty <= '1';
                else
                    Empty <= '0';
                end if;

                if Count = FIFO_DEPTH then
                    Full <= '1';
                else
                    Full <= '0';
                end if;

            end if;

        end if;

    end process;

end Behavioral;






































