        -- Write second data
        DataIn <= "00001111";
        wait for 20 ns;
        -- Write third data
        DataIn <= "11001100";
        wait for 20 ns;

        -- Stop writing
        WriteEn <= '0';
        wait for 20 ns;

        -- Read first data
        ReadEn <= '1';
        wait for 20 ns;

        -- Read second data
        wait for 20 ns;

        -- Read third data
        wait for 20 ns;

        -- Stop reading
        ReadEn <= '0';
        wait;

    end process;

END behavior;

